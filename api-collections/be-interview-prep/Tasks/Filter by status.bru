meta {
  name: Filter by status
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/tasks?status=IN_PROGRESS
  body: none
  auth: inherit
}

params:query {
  status: IN_PROGRESS
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns only IN_PROGRESS tasks, including the created one", function () {
    expect(res.body.length).to.be.above(0);
    res.body.forEach(function (task) { expect(task.status).to.equal("IN_PROGRESS"); });
    const ids = res.body.map(function (task) { return task.id; });
    expect(ids).to.include(bru.getVar("taskId"));
  });
}

docs {
  Lists only the tasks with one status.

  **Inputs to try:** the `status` query parameter (`TODO`, `IN_PROGRESS`, `DONE`). Any other value
  returns 400 naming the allowed values.

  **Expect:** 200 with only matching tasks.
}
