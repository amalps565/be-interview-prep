meta {
  name: List tasks
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/tasks
  body: none
  auth: inherit
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("includes the created task", function () {
    const ids = res.body.map(function (task) { return task.id; });
    expect(ids).to.include(bru.getVar("taskId"));
  });
}
