meta {
  name: Get task
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/tasks/:id
  body: none
  auth: inherit
}

params:path {
  id: {{taskId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the created task", function () {
    expect(res.body.id).to.equal(bru.getVar("taskId"));
    expect(res.body.title).to.equal("Write tests");
  });
}

docs {
  Reads one task.

  **Inputs to try:** the `id` path parameter (defaults to `taskId` from **Create task**). An unknown
  id returns 404.

  **Expect:** 200 with the task.
}
