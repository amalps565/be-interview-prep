meta {
  name: Create task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Write tests",
    "description": "Cover the task API from Bruno",
    "status": "IN_PROGRESS",
    "dueDate": "2030-01-01"
  }
}

script:post-response {
  bru.setVar("taskId", res.body.id);
}

tests {
  test("returns 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the new task with an id and a Location header", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.body.title).to.equal("Write tests");
    expect(res.body.status).to.equal("IN_PROGRESS");
    expect(res.headers["location"]).to.equal("/api/tasks/" + res.body.id);
  });
}
