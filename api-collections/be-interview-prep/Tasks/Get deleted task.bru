meta {
  name: Get deleted task
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/tasks/:id
  body: none
  auth: inherit
}

params:path {
  id: {{taskId}}
}

tests {
  test("returns 404 Not Found", function () {
    expect(res.status).to.equal(404);
  });

  test("returns the JSON error shape", function () {
    expect(res.body.status).to.equal(404);
    expect(res.body.path).to.equal("/api/tasks/" + bru.getVar("taskId"));
  });
}

docs {
  Reads the task that **Delete task** removed.

  **Expect:** 404 in the shared JSON error format.
