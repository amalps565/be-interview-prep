meta {
  name: Insufficient stock
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{shortStockKey}}
}

body:json {
  {
    "items": [
      { "productId": {{productBId}}, "quantity": 1 },
      { "productId": {{productAId}}, "quantity": 1 }
    ]
  }
}

script:pre-request {
  bru.setVar("shortStockKey", "short-" + Date.now() + "-" + Math.random().toString(36).slice(2, 10));
}

tests {
  test("returns 409 Conflict", function () {
    expect(res.status).to.equal(409);
  });

  test("names the product that is out of stock", function () {
    expect(res.body.message).to.include("Bruno Order Kettle");
    expect(res.body.message).to.include(String(bru.getVar("productAId")));
  });
}

docs {
  Orders one B and one A after **Place order** took all of A.

  **Idempotency-Key:** the Headers tab sends `{{shortStockKey}}`, a new value per send set by the
  pre-request script. You can replace it with any fixed string such as `order-002`.

  **Inputs to try:** raise a `quantity` above the product's stock.

  **Expect:** 409 with a message naming product A. Nothing is reserved, so B keeps its stock.
}
