meta {
  name: Cancel again
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/orders/:id/cancel
  body: none
  auth: inherit
}

params:path {
  id: {{orderId}}
}

tests {
  test("returns 409 Conflict", function () {
    expect(res.status).to.equal(409);
  });

  test("says the order is already cancelled", function () {
    expect(res.body.message).to.include("already cancelled");
  });
}

docs {
  Cancels the same order a second time.

  **Expect:** 409 "Order N is already cancelled". Stock is not returned twice.
}
