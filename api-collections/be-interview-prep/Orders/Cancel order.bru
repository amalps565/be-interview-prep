meta {
  name: Cancel order
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/orders/{{orderId}}/cancel
  body: none
  auth: inherit
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("marks the order CANCELLED", function () {
    expect(res.body.id).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("CANCELLED");
  });
}
