meta {
  name: Cancel order
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/orders/:id/cancel
  body: none
  auth: inherit
}

params:path {
  id: {{orderId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("marks the order CANCELLED", function () {
    expect(res.body.id).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("CANCELLED");
  });
}

docs {
  Cancels your order and returns its items to stock.

  **Inputs to try:** the `id` path parameter.

  **Expect:** 200 with status `CANCELLED`.
}
