meta {
  name: Place order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: inherit
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

body:json {
  {
    "items": [
      { "productId": {{productAId}}, "quantity": 2 },
      { "productId": {{productBId}}, "quantity": 1 }
    ]
  }
}

script:pre-request {
  const uuid = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
    const r = Math.floor(Math.random() * 16);
    return (c === "x" ? r : (r & 0x3) | 0x8).toString(16);
  });
  bru.setVar("idempotencyKey", uuid);
}

script:post-response {
  bru.setVar("orderId", res.body.id);
}

tests {
  test("returns 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("returns the placed order with its Location and total", function () {
    expect(res.body.id).to.be.a("number");
    expect(res.headers["location"]).to.equal("/api/orders/" + res.body.id);
    expect(res.body.status).to.equal("PLACED");
    expect(res.body.total).to.equal(22.5);
    expect(res.body.items.length).to.equal(2);
  });
}

docs {
  Orders 2 of product A and 1 of product B and stores the order id in `orderId`.

  **Idempotency-Key:** the Headers tab sends `{{idempotencyKey}}`, which the pre-request script sets
  to a new UUID on every send so each send is a new order. To see a retry being recognised, replace
  the header value with any fixed string such as `order-001`, send once (201), then send again
  unchanged (200 with `Idempotent-Replayed: true` and the same order).

  **Inputs to try:** the `items` in the body (`productId` and `quantity` 1 to 1000).

  **Expect:** 201 with the order, a `Location` header and `total` 22.5. Product A then has 0 left.
}
