meta {
  name: Create product A as admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/products
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Bruno Order Kettle",
    "category": "Home",
    "price": 10.00,
    "stock": 2,
    "rating": 4.0
  }
}

script:post-response {
  bru.setVar("productAId", res.body.id);
}

tests {
  test("returns 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("starts with 2 in stock", function () {
    expect(res.body.stock).to.equal(2);
  });
}

docs {
  Adds product A (price 10.00, stock 2) with the admin token and stores its id in `productAId`, so
  the order requests below work with known stock numbers.

  **Inputs to try:** `price` and `stock` in the body; the order total and stock checks below assume
  10.00 and 2.

  **Expect:** 201 with the product.
}
