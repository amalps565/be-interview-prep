meta {
  name: Get order
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/orders/:id
  body: none
  auth: inherit
}

params:path {
  id: {{orderId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the placed order", function () {
    expect(res.body.id).to.equal(bru.getVar("orderId"));
    expect(res.body.status).to.equal("PLACED");
    expect(res.body.total).to.equal(22.5);
  });
}

docs {
  Reads your order.

  **Inputs to try:** the `id` path parameter. Another customer's order or an unknown id returns 404.

  **Expect:** 200 with status `PLACED`, the lines and `total` 22.5.
}
