meta {
  name: Product stock after cancel
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: inherit
}

params:path {
  id: {{productAId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("shows the cancelled items back in stock", function () {
    expect(res.body.stock).to.equal(2);
  });
}

docs {
  Reads product A after the cancel.

  **Expect:** 200 with stock back at 2.
}
