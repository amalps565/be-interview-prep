meta {
  name: Get deleted product
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/api/products/{{newProductId}}
  body: none
  auth: inherit
}

tests {
  test("returns 404 Not Found", function () {
    expect(res.status).to.equal(404);
  });

  test("returns the JSON error shape", function () {
    expect(res.body.status).to.equal(404);
    expect(res.body.path).to.equal("/api/products/" + bru.getVar("newProductId"));
  });
}
