meta {
  name: Get product
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: inherit
}

params:path {
  id: {{firstProductId}}
}

script:post-response {
  bru.setVar("productId", res.body.id);
  bru.setVar("productName", res.body.name);
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the product from the list", function () {
    expect(res.body.id).to.equal(bru.getVar("firstProductId"));
    expect(res.body.name).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Reads one product and stores its id in `productId`. The first read fills the cache.

  **Inputs to try:** the `id` path parameter (defaults to the first product from **List
  products**). An unknown id returns 404.

  **Expect:** 200 with the product.
}
