meta {
  name: Delete product as admin
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: bearer
}

params:path {
  id: {{newProductId}}
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("returns 204 No Content", function () {
    expect(res.status).to.equal(204);
  });
}

docs {
  Removes the new product with the admin token.

  **Inputs to try:** the `id` path parameter. Do not point it at a seeded product you still want.

  **Expect:** 204 with no body.
}
