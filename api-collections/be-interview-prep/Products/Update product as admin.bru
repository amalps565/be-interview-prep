meta {
  name: Update product as admin
  type: http
  seq: 10
}

put {
  url: {{baseUrl}}/api/products/:id
  body: json
  auth: bearer
}

params:path {
  id: {{newProductId}}
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Bruno Test Lamp",
    "category": "Home",
    "price": 59.5,
    "stock": 7,
    "rating": 4.5
  }
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the new price and stock", function () {
    expect(res.body.id).to.equal(bru.getVar("newProductId"));
    expect(res.body.price).to.equal(59.5);
    expect(res.body.stock).to.equal(7);
  });
}

docs {
  Changes the new product's price and stock with the admin token.

  **Inputs to try:** the `id` path parameter and any field in the body.

  **Expect:** 200 with the updated product; 404 for an unknown id.
}
