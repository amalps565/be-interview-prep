meta {
  name: Unknown sort field
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/products?sort=colour,asc
  body: none
  auth: inherit
}

params:query {
  sort: colour,asc
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.status).to.equal(400);
  });

  test("names the sort field", function () {
    const fields = res.body.fieldErrors.map(function (error) { return error.field; });
    expect(fields).to.include("sort");
  });
}

docs {
  Sorts on a field products do not have.

  **Inputs to try:** the `sort` query parameter; a real field such as `rating,desc` returns 200.

  **Expect:** 400 with a `fieldErrors` entry for `sort` listing the allowed fields.
}
