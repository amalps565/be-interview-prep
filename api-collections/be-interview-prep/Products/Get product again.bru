meta {
  name: Get product again
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: inherit
}

params:path {
  id: {{productId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the same product from the cache", function () {
    expect(res.body.id).to.equal(bru.getVar("productId"));
    expect(res.body.name).to.equal(bru.getVar("productName"));
  });
}

docs {
  Reads the same product a second time. This one is served from the cache without a database
  query, which usually shows as a shorter response time.

  **Inputs to try:** the `id` path parameter.

  **Expect:** 200 with the same product as **Get product**.
}
