meta {
  name: Get updated product
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: inherit
}

params:path {
  id: {{newProductId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("shows the new price, not a stale cached one", function () {
    expect(res.body.price).to.equal(59.5);
    expect(res.body.stock).to.equal(7);
  });
}

docs {
  Reads the product again after the update.

  **Expect:** 200 with the new price 59.5 and stock 7, which shows the cache was refreshed rather
  than serving the old price.
}
