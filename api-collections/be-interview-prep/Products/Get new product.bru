meta {
  name: Get new product
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/api/products/:id
  body: none
  auth: inherit
}

params:path {
  id: {{newProductId}}
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the original price and puts it in the cache", function () {
    expect(res.body.id).to.equal(bru.getVar("newProductId"));
    expect(res.body.price).to.equal(49.99);
  });
}

docs {
  Reads the new product once so it sits in the cache before **Update product as admin**.

  **Expect:** 200 with price 49.99.
}
