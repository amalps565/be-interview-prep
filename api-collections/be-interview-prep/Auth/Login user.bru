meta {
  name: Login user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{yourPassword}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.accessToken);
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer access token", function () {
    expect(res.body.accessToken).to.be.a("string").and.not.be.empty;
    expect(res.body.tokenType).to.equal("Bearer");
  });
}

docs {
  Logs in as the user from **Register user** and stores the access token in `token`. Every other
  request in the collection sends it as `Authorization: Bearer {{token}}`.

  **Inputs to try:** a wrong password returns 401 with the same message as an unknown email.

  **Expect:** 200 with `accessToken` (valid for 15 minutes), `tokenType` and `expiresIn`. Send this
  again when the token expires.
}
