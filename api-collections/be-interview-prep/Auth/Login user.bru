meta {
  name: Login user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  req.setBody({ email: bru.getVar("userEmail"), password: bru.getVar("userPassword") });
}

script:post-response {
  bru.setVar("token", res.body.accessToken);
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer access token", function () {
    expect(res.body.accessToken).to.be.a("string").and.not.be.empty;
    expect(res.body.tokenType).to.equal("Bearer");
  });
}
