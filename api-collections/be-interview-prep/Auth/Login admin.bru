meta {
  name: Login admin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  req.setBody({ email: bru.getEnvVar("adminEmail"), password: bru.getEnvVar("adminPassword") });
}

script:post-response {
  bru.setVar("adminToken", res.body.accessToken);
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer access token", function () {
    expect(res.body.accessToken).to.be.a("string").and.not.be.empty;
  });
}
