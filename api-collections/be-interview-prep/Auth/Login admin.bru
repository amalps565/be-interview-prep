meta {
  name: Login admin
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{yourAdminPassword}}"
  }
}

script:post-response {
  bru.setVar("adminToken", res.body.accessToken);
}

tests {
  test("returns 200 OK", function () {
    expect(res.status).to.equal(200);
  });

  test("returns a bearer access token", function () {
    expect(res.body.accessToken).to.be.a("string").and.not.be.empty;
  });
}

docs {
  Logs in as the admin the app created from `ADMIN_EMAIL` and `ADMIN_PASSWORD`, and stores the token
  in `adminToken`. The admin requests in this collection send that token instead of `token`.

  **Inputs:** fill the secret values `adminEmail` and `yourAdminPassword` in the `local`
  environment with the values the app was started with.

  **Expect:** 200 with `accessToken`.
}
