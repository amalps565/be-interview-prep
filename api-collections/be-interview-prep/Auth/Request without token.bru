meta {
  name: Request without token
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: none
}

tests {
  test("returns 401 Unauthorized", function () {
    expect(res.status).to.equal(401);
  });

  test("returns the JSON error shape", function () {
    expect(res.body.status).to.equal(401);
    expect(res.body.path).to.equal("/api/users/me");
  });
}

docs {
  Calls a protected endpoint with no `Authorization` header (Auth tab is set to No Auth).

  **Expect:** 401 in the shared JSON error format.
}
