meta {
  name: List users as USER
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/admin/users
  body: none
  auth: inherit
}

tests {
  test("returns 403 Forbidden for a USER", function () {
    expect(res.status).to.equal(403);
  });

  test("returns the JSON error shape", function () {
    expect(res.body.status).to.equal(403);
  });
}

docs {
  Calls the admin-only user list with the normal user's token.

  **Expect:** 403 in the shared JSON error format, because a `USER` lacks the `ADMIN` role.
}
