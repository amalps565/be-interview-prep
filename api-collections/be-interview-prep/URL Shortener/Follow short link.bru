meta {
  name: Follow short link
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/:code
  body: none
  auth: none
}

params:path {
  code: {{code}}
}

settings {
  encodeUrl: true
  followRedirects: false
}

tests {
  test("returns 302 Found", function () {
    expect(res.status).to.equal(302);
  });

  test("redirects to the original URL", function () {
    expect(res.headers["location"]).to.equal(bru.getVar("shortenedUrl"));
  });
}

docs {
  Opens the short link without a token, like a browser would. Redirect following is turned off in
  Settings so you can see the redirect itself.

  **Inputs to try:** the `code` path parameter. An unknown code returns 404 and an expired one 410.

  **Expect:** 302 with a `Location` header pointing at the original URL. Each visit adds one to the
  link's visit count.
}
