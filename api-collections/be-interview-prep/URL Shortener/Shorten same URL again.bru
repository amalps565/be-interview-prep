meta {
  name: Shorten same URL again
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/urls
  body: json
  auth: inherit
}

body:json {
  {
    "url": "{{shortenedUrl}}"
  }
}

tests {
  test("returns 200 OK for an existing link", function () {
    expect(res.status).to.equal(200);
  });

  test("returns the same code", function () {
    expect(res.body.code).to.equal(bru.getVar("code"));
  });
}

docs {
  Sends the URL from **Shorten URL** again (`shortenedUrl`).

  **Expect:** 200 with the same `code`, because a URL with the same expiry is only stored once.
}
