meta {
  name: Shorten with custom code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/urls
  body: json
  auth: inherit
}

body:json {
  {
    "url": "{{longUrl}}",
    "customCode": "{{customCode}}",
    "expiresAt": "2030-01-01T00:00:00Z"
  }
}

script:pre-request {
  bru.setVar("customCode", "b" + Math.random().toString(36).slice(2, 9));
}

tests {
  test("returns 201 Created", function () {
    expect(res.status).to.equal(201);
  });

  test("uses the requested code and expiry", function () {
    expect(res.body.code).to.equal(bru.getVar("customCode"));
    expect(res.body.expiresAt).to.equal("2030-01-01T00:00:00Z");
  });
}
